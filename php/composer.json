{
  "archive": {
    "exclude": [
      "/vendor",
      "/composer.lock",
      "/.git",
      "/*.zip"
    ]
  },
  "autoload": {
    "classmap": [
      "src/SchemaAdapter.php",
      "custom/"
    ],
    "files": [
      "src/credentials.php"
    ],
    "psr-4": {
      "Flint\\": "src/classes/"
    }
  },
  "description": "Flint Public API server SDK",
  "license": "Apache-2.0",
  "name": "flintpay/flint",
  "require": {
    "ext-curl": "*",
    "ext-json": "*",
    "php": ">=8.2"
  },
  "suggest": {
    "ext-openssl": "Required for ES256 webhook verification",
    "psr/http-client": "Optional PSR-18 JWKS HTTP client",
    "psr/http-factory": "Optional PSR-17 request factory for the JWKS HTTP client",
    "psr/simple-cache": "Optional PSR-16 JWKS cache"
  },
  "type": "library",
  "version": "6.0.0"
}
