{
  "version": "0.2.0-beta.1",
  "npm": {
    "name": "@flintpay/node",
    "access": "public"
  },
  "composer": {
    "name": "flintpay/flint",
    "namespace": "Flint"
  },
  "validation": "schema",
  "numericUnions": "explicit",
  "schemaSharing": "named",
  "models": {
    "Money": "MoneyValue",
    "Return": "ReturnResource",
    "DeliveryCalculatedPricingStrategyInput": "DeliveryCalculatedPricingStrategyRequest",
    "DeliveryDistanceUnitPriceInput": "DeliveryDistanceUnitPriceRequest",
    "DeliveryEstimateRuleInput": "DeliveryEstimateRuleRequest",
    "DeliveryFixedPricingStrategyInput": "DeliveryFixedPricingStrategyRequest",
    "DeliveryMethodConfigurationInput": "DeliveryMethodConfigurationRequest",
    "DeliveryMethodOriginSelectorInput": "DeliveryMethodOriginSelectorRequest",
    "DeliveryPricingRateInput": "DeliveryPricingRateRequest",
    "DeliveryPricingStrategyInput": "DeliveryPricingStrategyRequest",
    "DeliveryPricingTierBandInput": "DeliveryPricingTierBandRequest",
    "DeliveryProfileConfigurationInput": "DeliveryProfileConfigurationRequest",
    "DeliveryProfileOriginPolicyInput": "DeliveryProfileOriginPolicyRequest",
    "DeliveryRateTablePricingStrategyInput": "DeliveryRateTablePricingStrategyRequest",
    "DeliveryScheduleWindowRuleInput": "DeliveryScheduleWindowRuleRequest",
    "DeliveryTieredPricingStrategyInput": "DeliveryTieredPricingStrategyRequest",
    "DeliveryWeightUnitPriceInput": "DeliveryWeightUnitPriceRequest",
    "FulfillmentLineItemInput": "FulfillmentLineItemRequest",
    "ImageInput": "ImageRequest",
    "InventoryReceiptLineInput": "InventoryReceiptLineRequest",
    "InventoryRoutingSourceInput": "InventoryRoutingSourceRequest",
    "InventorySourceSystemInput": "InventorySourceSystemRequest",
    "InventoryTransferLineInput": "InventoryTransferLineRequest",
    "LocationInventoryInput": "LocationInventoryRequest",
    "ModifierInput": "ModifierRequest",
    "ModifierSetGroupInput": "ModifierSetGroupRequest",
    "OnboardingProfileInput": "OnboardingProfileRequest",
    "OrderChargeInput": "OrderChargeRequest",
    "OrderDeliveryDestinationAddressInput": "OrderDeliveryDestinationAddressRequest",
    "OrderDeliveryDestinationInput": "OrderDeliveryDestinationRequest",
    "OrderDeliveryDestinationRecipientInput": "OrderDeliveryDestinationRecipientRequest",
    "OrderLineItemModifierInput": "OrderLineItemModifierRequest",
    "OrderTaxInput": "OrderTaxRequest",
    "OrderTaxLocationInput": "OrderTaxLocationRequest",
    "PaymentLinkCustomFieldInput": "PaymentLinkCustomFieldRequest",
    "PaymentLinkLineItemInput": "PaymentLinkLineItemRequest",
    "ProductVariantInput": "ProductVariantRequest",
    "ReturnInspectionLineItemInput": "ReturnInspectionLineItemRequest",
    "ReturnLineItemInput": "ReturnLineItemRequest",
    "ReturnPolicyRevisionInput": "ReturnPolicyRevisionRequest",
    "ReturnReceiptLineItemInput": "ReturnReceiptLineItemRequest",
    "ReturnReplacementLineItemInput": "ReturnReplacementLineItemRequest",
    "ReturnResolutionAdjustmentInput": "ReturnResolutionAdjustmentRequest",
    "ReturnResolutionLineItemInput": "ReturnResolutionLineItemRequest",
    "SubscriptionPlanLineItemInput": "SubscriptionPlanLineItemRequest",
    "SubscriptionServiceLocationInput": "SubscriptionServiceLocationRequest",
    "TextModifierConfigInput": "TextModifierConfigRequest"
  },
  "errors": {
    "codePath": "error.code",
    "detailsPath": "error",
    "requestIdHeader": "X-Request-Id"
  },
  "webhook": {
    "algorithm": "hmac-sha256",
    "format": "standard-webhooks",
    "header": "webhook-signature",
    "timestampHeader": "webhook-timestamp",
    "idHeader": "webhook-id",
    "separator": ".",
    "toleranceSeconds": 300,
    "typeField": "event_type",
    "events": {}
  },
  "apiVersion": {
    "header": "Flint-Version",
    "value": "2026-09-07"
  },
  "targets": [
    "node",
    "php"
  ],
  "release": {
    "policy": "semver"
  }
}
