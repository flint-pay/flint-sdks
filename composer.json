{
  "archive": {
    "exclude": [
      "/.git",
      "/.github",
      "/.context",
      "/.tools",
      "/.generated",
      "/.gitignore",
      "/.gitattributes",
      "/AGENTS.md",
      "/CLAUDE.md",
      "/claude",
      "/CONTRIBUTING.md",
      "/node",
      "/node_modules",
      "/vendor",
      "/composer.lock",
      "/php/vendor",
      "/php/composer.lock",
      "/spec",
      "/scripts",
      "/tests",
      "/releases",
      "/sdk.json",
      "/sdk.lock.json",
      "/sdk-files.json",
      "/package.json",
      "/package-lock.json",
      "/RELEASING.md",
      "**/vendor",
      "**/vendor/**",
      "**/node_modules",
      "**/node_modules/**"
    ]
  },
  "autoload": {
    "classmap": [
      "php/src/SchemaAdapter.php",
      "php/custom/"
    ],
    "files": [
      "php/src/credentials.php"
    ],
    "psr-4": {
      "Flint\\": "php/src/classes/"
    }
  },
  "description": "Flint Public API server SDK",
  "license": "Apache-2.0",
  "name": "flintpay/flint",
  "require": {
    "ext-curl": "*",
    "ext-json": "*",
    "php": ">=8.2"
  },
  "suggest": {
    "ext-openssl": "Required for ES256 webhook verification",
    "psr/http-client": "Optional PSR-18 JWKS HTTP client",
    "psr/http-factory": "Optional PSR-17 request factory for the JWKS HTTP client",
    "psr/simple-cache": "Optional PSR-16 JWKS cache"
  },
  "type": "library",
  "homepage": "https://developers.withflintpay.com",
  "support": {
    "issues": "https://github.com/flint-pay/flint-sdks/issues",
    "source": "https://github.com/flint-pay/flint-sdks"
  }
}
