{
  "$schema": "https://raw.githubusercontent.com/flint-pay/sdk-generator/c5e0e964c5096a5267f251e91acaf9870f3e4f37/sdk-config.schema.json",
  "profiles": [
    "spec/profiles/full-merchant-sdk.json",
    "spec/profiles/full-customer-sdk.json",
    "spec/profiles/full-onboarding-sdk.json",
    "spec/profiles/full-checkout-sdk.json",
    "spec/profiles/full-invoice-sdk.json"
  ],
  "documentation": {
    "authShortcut": "apiKey"
  },
  "auth": {
    "shortcuts": {
      "apiKey": {
        "mode": "merchant",
        "scheme": "BearerAuth"
      }
    },
    "defaultCredentials": {
      "mode": "merchant",
      "scheme": "BearerAuth",
      "environment": {
        "apiKey": "FLINT_API_KEY",
        "token": "FLINT_ACCESS_TOKEN"
      },
      "workloadIdentity": {
        "tokenPath": "/v1/oauth/token",
        "credentialParameter": "workload_identity_id",
        "envPrefix": "FLINT"
      }
    }
  }
}
